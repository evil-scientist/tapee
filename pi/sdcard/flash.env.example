# Settings for flash.sh. Copy to pi/flash.env (git ignores it) and fill in.
HOSTNAME=tapee
PI_USER=sury
# Leave PI_PASSWORD empty to allow SSH key login only.
PI_PASSWORD=
SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub
WIFI_SSID=
WIFI_PASSWORD=
# Two-letter country code; the Pi won't turn on Wi-Fi without it.
WIFI_COUNTRY=GB
TIMEZONE=Europe/London
KEYMAP=gb
